<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Demos and hand-rolled benchmarks are not library code. -->
    <Match>
        <Package name="~com\.quantfinlib\.examples(\..*)?"/>
    </Match>

    <!-- EI_EXPOSE_REP / EI_EXPOSE_REP2: no global exclusion. Value and
         result types copy arrays and collections on construction and hand
         out elements or copies only. The matches below are per method, each
         with its reason. -->

    <!-- Flyweight wrap(...): the view reads the caller's buffer in place by
         design (zero-copy decode/encode). The caller keeps ownership; the
         view holds the reference only until the next wrap, and the javadoc
         of each wrap method says so. Copying would defeat the flyweight. -->
    <Match>
        <Class name="com.quantfinlib.fix.FixExecReportView"/>
        <Method name="wrap"/>
        <Field name="buf"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.quantfinlib.fix.FixMarketDataView"/>
        <Method name="wrap"/>
        <Field name="buf"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.quantfinlib.marketdata.ItchCodec$View"/>
        <Method name="wrap"/>
        <Field name="buf"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.quantfinlib.sbe.OrderFlyweight"/>
        <Method name="wrap"/>
        <Field name="buffer"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.quantfinlib.sbe.QuoteFlyweight"/>
        <Method name="wrap"/>
        <Field name="buffer"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.quantfinlib.sbe.TradeFlyweight"/>
        <Method name="wrap"/>
        <Field name="buffer"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Injected collaborators: these constructors and setters wire a shared
         service (a gateway, risk gate, scorecard, venue book, output channel,
         covariance model or universe) into the object that uses it. The
         reference is the dependency, not internal state, and sharing it is
         the point: the quoter must send through the same gateway the venue
         acknowledges into. Copying would break the wiring. -->
    <Match>
        <Class name="com.quantfinlib.backtest.portfolio.CrossSectionalMomentum"/>
        <Method name="&lt;init&gt;"/>
        <Field name="universe"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.quantfinlib.execution.AdaptiveSor"/>
        <Method name="&lt;init&gt;"/>
        <Field name="scorecard"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.quantfinlib.execution.AdaptiveSor"/>
        <Method name="scorecard"/>
        <Field name="scorecard"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="com.quantfinlib.execution.PortfolioExecutor"/>
        <Method name="useRiskModel"/>
        <Field name="riskModel"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.quantfinlib.fx.LpRouter"/>
        <Method name="&lt;init&gt;"/>
        <Field name="book"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.quantfinlib.fx.LpRouter"/>
        <Method name="&lt;init&gt;"/>
        <Field name="card"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.quantfinlib.sbe.BinaryOrderPublisher"/>
        <Method name="&lt;init&gt;"/>
        <Field name="channel"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.quantfinlib.trading.AutoHedger"/>
        <Method name="&lt;init&gt;"/>
        <Field name="gateway"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.quantfinlib.trading.HftQuoter"/>
        <Method name="&lt;init&gt;"/>
        <Field name="gateway"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.quantfinlib.trading.LoopbackVenue"/>
        <Method name="&lt;init&gt;"/>
        <Field name="gateway"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.quantfinlib.trading.TradingDashboard"/>
        <Method name="&lt;init&gt;"/>
        <Field name="gateway"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.quantfinlib.trading.HftOrderGateway"/>
        <Method name="&lt;init&gt;"/>
        <Field name="riskGate"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.quantfinlib.trading.HftOrderGateway"/>
        <Method name="riskGate"/>
        <Field name="riskGate"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    <!-- Recorded failures: failure() returns the exception the worker
         thread caught, so the caller can inspect or rethrow it. It is a
         diagnostic hand-off, not state the object depends on. -->
    <Match>
        <Class name="com.quantfinlib.marketdata.TickCapture"/>
        <Method name="failure"/>
        <Field name="failure"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="com.quantfinlib.marketdata.HftMarketDataBus"/>
        <Method name="failure"/>
        <Field name="failure"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="com.quantfinlib.trading.HftOrderGateway"/>
        <Method name="failure"/>
        <Field name="failure"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>


    <!-- Single-writer classes documented as not thread-safe. The AT_
         detectors assume any field may be shared. -->
    <Match>
        <Class name="com.quantfinlib.util.LatencyRecorder"/>
        <Bug pattern="AT_NONATOMIC_64BIT_PRIMITIVE,AT_NONATOMIC_OPERATIONS_ON_SHARED_VARIABLE"/>
    </Match>
    <!-- Used only from the gateway's venue thread (see class javadoc). -->
    <Match>
        <Class name="com.quantfinlib.sbe.BinaryOrderPublisher"/>
        <Bug pattern="AT_NONATOMIC_64BIT_PRIMITIVE,AT_NONATOMIC_OPERATIONS_ON_SHARED_VARIABLE,AT_STALE_THREAD_WRITE_OF_PRIMITIVE"/>
    </Match>
    <!-- resendPending and resendTriggerSeq are touched only by the reader
         thread (field comments say so). -->
    <Match>
        <Class name="com.quantfinlib.fix.FixSession"/>
        <Or>
            <Field name="resendPending"/>
            <Field name="resendTriggerSeq"/>
        </Or>
        <Bug pattern="AT_NONATOMIC_64BIT_PRIMITIVE,AT_STALE_THREAD_WRITE_OF_PRIMITIVE"/>
    </Match>
    <!-- The unsynchronised accesses are in readSeqPage, writeSeqPage and
         migrateLegacy, reached from the constructor or from synchronized
         methods; the object is not shared before construction ends. -->
    <Match>
        <Class name="com.quantfinlib.fix.FileSessionStore"/>
        <Bug pattern="IS2_INCONSISTENT_SYNC"/>
    </Match>
    <!-- routeIds is written in start() before the volatile write of
         routeShards, and publish() reads routeShards first, so the volatile
         pair publishes it safely without a lock on the hot path. -->
    <Match>
        <Class name="com.quantfinlib.trading.ShardedTradingEngine"/>
        <Field name="routeIds"/>
        <Bug pattern="IS2_INCONSISTENT_SYNC"/>
    </Match>
    <!-- PDF syntax requires a bare LF; %n would write CRLF on Windows and
         break the byte offsets in the xref table. -->
    <Match>
        <Class name="com.quantfinlib.report.PdfReportExporter"/>
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
    </Match>
    <!-- Marsaglia polar method: each pass accepts with probability pi/4, so
         the rejection loop terminates almost surely. SpotBugs cannot see that
         the random draws change on every iteration. -->
    <Match>
        <Class name="com.quantfinlib.hedging.HedgingSimulator"/>
        <Method name="gaussian"/>
        <Bug pattern="IL_INFINITE_LOOP"/>
    </Match>
</FindBugsFilter>
