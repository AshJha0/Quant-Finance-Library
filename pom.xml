<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.quantfinlib</groupId>
    <artifactId>quant-finance-library</artifactId>
    <version>2.2.0</version>
    <packaging>jar</packaging>
    <name>Quant-Finance-Library</name>
    <description>Pure-JDK quantitative finance library: pricing, market risk, alpha research and backtesting, plus a reference low-latency trading lane.</description>
    <url>https://github.com/AshJha0/Quant-Finance-Library</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>AshJha0</id>
            <name>Ashish Nath Jha</name>
            <url>https://github.com/AshJha0</url>
        </developer>
    </developers>
    <scm>
        <url>https://github.com/AshJha0/Quant-Finance-Library</url>
        <connection>scm:git:https://github.com/AshJha0/Quant-Finance-Library.git</connection>
        <developerConnection>scm:git:https://github.com/AshJha0/Quant-Finance-Library.git</developerConnection>
        <tag>HEAD</tag>
    </scm>
    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.outputTimestamp>2026-11-02T09:23:17Z</project.build.outputTimestamp>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>6.1.3</junit.version>
        <jmh.version>1.37</jmh.version>
        <errorprone.version>2.51.0</errorprone.version>
        <jspecify.version>1.0.0</jspecify.version>
        <japicmp.version>0.26.5</japicmp.version>
        <pitest.version>1.30.1</pitest.version>
        <pitest.junit5.version>1.2.3</pitest.junit5.version>
        <!-- API compatibility baseline: the released 2.1.0 library jar, taken
             from the GitHub release assets (scripts/fetch-api-baseline.sh). -->
        <api.baseline.version>2.1.0</api.baseline.version>
        <api.baseline.jar>${user.home}/.m2/api-baseline/quant-finance-library-${api.baseline.version}.jar</api.baseline.jar>
        <!-- Test tags: load (throughput/soak floors), timing (wall-clock or
             sleep-based assertions), socket (real loopback sockets). The
             default run skips load and timing because they are sensitive to
             shared-runner CPU contention; -Pfull runs everything. -->
        <test.excludedGroups>load,timing</test.excludedGroups>
    </properties>
    <dependencies>
        <!--  Zero runtime dependencies: the core library is pure JDK for minimal
                     footprint and predictable ultra-low-latency behavior.
                     JUnit and JMH are test-scope only.  -->
        <!-- JSpecify nullness annotations (@NullMarked on the stable packages).
             Compile-time only: provided and optional, so it is neither packaged
             nor passed on to users. The JVM ignores an annotation whose class
             is absent at run time. -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>${jspecify.version}</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <pluginManagement>
            <plugins>
                <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-clean-plugin</artifactId><version>3.5.0</version></plugin>
                <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.5.0</version></plugin>
                <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-install-plugin</artifactId><version>3.2.0</version></plugin>
                <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-deploy-plugin</artifactId><version>3.2.0</version></plugin>
                <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-site-plugin</artifactId><version>3.22.0</version></plugin>
                <plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.6.4</version></plugin>
                <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-help-plugin</artifactId><version>3.5.2</version></plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.7.0</version>
                <executions>
                    <execution>
                        <id>enforce-toolchain</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <showWarnings>true</showWarnings>
                    <!-- Any javac lint warning fails the build. -->
                    <failOnWarning>true</failOnWarning>
                    <compilerArgs>
                        <!-- All lint categories as warnings. "processing" is off
                             because the JMH processor runs on main sources too and
                             reports "no processor claimed annotations" noise. -->
                        <arg>-Xlint:all,-processing</arg>
                    </compilerArgs>
                    <!--  JMH benchmark generation (test sources only use it).  -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${jmh.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <!-- Test sources are compiled into the com.quantfinlib module
                         (patched in by the plugin). The allocation probes use the
                         management MXBeans, which the library itself does not need. -->
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs combine.children="append">
                                <arg>--add-modules=java.management,jdk.management</arg>
                                <arg>--add-reads=com.quantfinlib=java.management,jdk.management</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
                <configuration>
                    <!-- Tests run on the class path: JUnit, JMH and the
                         reflective test helpers need no opens clauses, and
                         ModuleDescriptorTest checks the descriptor itself. -->
                    <useModulePath>false</useModulePath>
                    <excludedGroups>${test.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <!-- The library jar carries no demos or hand-rolled benchmarks. -->
                    <execution>
                        <id>default-jar</id>
                        <configuration>
                            <archive>
                                <manifest>
                                    <mainClass>com.quantfinlib.cli.Main</mainClass>
                                </manifest>
                            </archive>
                            <excludes>
                                <exclude>com/quantfinlib/examples/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <!-- Demos and benchmarks ship separately, classifier "examples",
                         built from the same compiled classes. -->
                    <execution>
                        <id>examples-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>examples</classifier>
                            <includes>
                                <include>com/quantfinlib/examples/**</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.16</version>
                <configuration>
                    <!--  Demos/benchmarks are run manually, not unit-tested;
                                             excluding them keeps the coverage number honest.  -->
                    <excludes>
                        <exclude>com/quantfinlib/examples/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- Coverage gate (runs in verify): whole library at least 90 %
                         of lines, every package at least 80 %. -->
                    <execution>
                        <id>check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                        <configuration>
                            <classifier>sources</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <configuration>
                    <doclint>all,-missing</doclint>
                    <quiet>true</quiet>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- Everything, including the load and timing tags (nightly CI). -->
        <profile>
            <id>full</id>
            <properties>
                <test.excludedGroups></test.excludedGroups>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <!-- Throughput floors need the machine to themselves. -->
                            <properties>
                                <configurationParameters>junit.jupiter.execution.parallel.enabled = false</configurationParameters>
                            </properties>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Static analysis: Error Prone (as a javac plugin) and SpotBugs.
             Error Prone style checks are reported as warnings; the checks
             listed below as ERROR (concurrency, numeric and ignored-result
             defects) fail the build. SpotBugs fails the build on any Medium
             or High finding not excluded in spotbugs-exclude.xml.
             Run with: ./mvnw -Panalysis -DskipTests clean verify -->
        <profile>
            <id>analysis</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <fork>true</fork>
                            <!-- Error Prone style warnings are advisory here. -->
                            <failOnWarning>false</failOnWarning>
                            <compilerArgs combine.children="append">
                                <arg>-XDcompilePolicy=simple</arg>
                                <arg>--should-stop=ifError=FLOW</arg>
                                <arg>-Xmaxwarns</arg>
                                <arg>10000</arg>
                                <arg>-Xplugin:ErrorProne -XepAllErrorsAsWarnings -XepDisableWarningsInGeneratedCode -XepExcludedPaths:.*/generated-test-sources/.* -Xep:NonAtomicVolatileUpdate:ERROR -Xep:IntLongMath:ERROR -Xep:NarrowCalculation:ERROR -Xep:FutureReturnValueIgnored:ERROR -Xep:UnusedVariable:ERROR -Xep:IdentityBinaryExpression:ERROR -Xep:LongDoubleConversion:ERROR -Xep:LongFloatConversion:ERROR -Xep:ReferenceEquality:ERROR -Xep:InvalidInlineTag:ERROR</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                                <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                                <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                            </compilerArgs>
                            <annotationProcessorPaths combine.children="append">
                                <path>
                                    <groupId>com.google.errorprone</groupId>
                                    <artifactId>error_prone_core</artifactId>
                                    <version>${errorprone.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <version>4.10.5.0</version>
                        <configuration>
                            <effort>Max</effort>
                            <threshold>Medium</threshold>
                            <failOnError>true</failOnError>
                            <xmlOutput>true</xmlOutput>
                            <excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
                        </configuration>
                        <executions>
                            <execution>
                                <id>spotbugs</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- API compatibility gate (japicmp) against the released 2.1.0 jar
             (api.baseline.version above).
             The stable packages listed in docs/STABILITY.md fail the build on
             any binary-incompatible change; the reference packages are compared
             and reported only. Fetch the baseline first:
               scripts/fetch-api-baseline.sh
               ./mvnw -Papi-compat -DskipTests verify
             Reports: target/japicmp/api-stable.html and api-all.html. -->
        <profile>
            <id>api-compat</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.siom79.japicmp</groupId>
                        <artifactId>japicmp-maven-plugin</artifactId>
                        <version>${japicmp.version}</version>
                        <configuration>
                            <oldVersion>
                                <file>
                                    <path>${api.baseline.jar}</path>
                                </file>
                            </oldVersion>
                            <newVersion>
                                <file>
                                    <path>${project.build.directory}/${project.build.finalName}.jar</path>
                                </file>
                            </newVersion>
                        </configuration>
                        <executions>
                            <execution>
                                <id>api-all</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>cmp</goal>
                                </goals>
                                <configuration>
                                    <parameter>
                                        <onlyModified>true</onlyModified>
                                        <accessModifier>protected</accessModifier>
                                        <ignoreMissingClasses>true</ignoreMissingClasses>
                                        <breakBuildOnBinaryIncompatibleModifications>false</breakBuildOnBinaryIncompatibleModifications>
                                        <breakBuildOnSourceIncompatibleModifications>false</breakBuildOnSourceIncompatibleModifications>
                                    </parameter>
                                </configuration>
                            </execution>
                            <execution>
                                <id>api-stable</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>cmp</goal>
                                </goals>
                                <configuration>
                                    <parameter>
                                        <onlyModified>true</onlyModified>
                                        <accessModifier>protected</accessModifier>
                                        <ignoreMissingClasses>true</ignoreMissingClasses>
                                        <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                                        <breakBuildOnSourceIncompatibleModifications>false</breakBuildOnSourceIncompatibleModifications>
                                        <includes>
                                        <include>com.quantfinlib.core</include>
                                        <include>com.quantfinlib.data</include>
                                        <include>com.quantfinlib.pricing</include>
                                        <include>com.quantfinlib.rates</include>
                                        <include>com.quantfinlib.credit</include>
                                        <include>com.quantfinlib.fx</include>
                                        <include>com.quantfinlib.commodities</include>
                                        <include>com.quantfinlib.markets</include>
                                        <include>com.quantfinlib.risk</include>
                                        <include>com.quantfinlib.crb</include>
                                        <include>com.quantfinlib.volatility</include>
                                        <include>com.quantfinlib.hedging</include>
                                        <include>com.quantfinlib.optimization</include>
                                        <include>com.quantfinlib.alpha</include>
                                        <include>com.quantfinlib.backtest</include>
                                        <include>com.quantfinlib.indicators</include>
                                        <include>com.quantfinlib.simulation</include>
                                        <include>com.quantfinlib.ml</include>
                                        <include>com.quantfinlib.screener</include>
                                        <include>com.quantfinlib.dsl</include>
                                        <include>com.quantfinlib.microstructure</include>
                                        <include>com.quantfinlib.execution</include>
                                        <include>com.quantfinlib.regulatory</include>
                                        <include>com.quantfinlib.rfq</include>
                                        <include>com.quantfinlib.report</include>
                                        <include>com.quantfinlib.cli</include>
                                        <include>com.quantfinlib.persist</include>
                                        <include>com.quantfinlib.backtest.*</include>
                                        <include>com.quantfinlib.stats</include>
                                        <include>com.quantfinlib.util.MathUtils</include>
                                        </includes>
                                        <excludes>
                                        <exclude>com.quantfinlib.data.TickFileWriter</exclude>
                                        <exclude>com.quantfinlib.data.TickFileReader</exclude>
                                        <exclude>com.quantfinlib.data.TickCapture</exclude>
                                        <exclude>com.quantfinlib.data.AsyncTickCapture</exclude>
                                        </excludes>
                                    </parameter>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Mutation testing (PIT) on pricing, risk, rates and volatility.
             Run nightly in CI; a full local run is long.
               ./mvnw -Pmutation test-compile org.pitest:pitest-maven:mutationCoverage
             Narrow it with -Dpit.targets=com.quantfinlib.pricing.*
             Report: target/pit-reports/index.html -->
        <profile>
            <id>mutation</id>
            <properties>
                <pit.targets>com.quantfinlib.pricing.*,com.quantfinlib.risk.*,com.quantfinlib.rates.*,com.quantfinlib.volatility.*</pit.targets>
                <pit.threads>4</pit.threads>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest.junit5.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>${pit.targets}</targetClasses>
                            <targetTests>${pit.targets}</targetTests>
                            <excludedGroups>
                                <excludedGroup>load</excludedGroup>
                                <excludedGroup>timing</excludedGroup>
                            </excludedGroups>
                            <threads>${pit.threads}</threads>
                            <timeoutFactor>2.0</timeoutFactor>
                            <timeoutConstant>4000</timeoutConstant>
                            <outputFormats>
                                <outputFormat>HTML</outputFormat>
                                <outputFormat>XML</outputFormat>
                            </outputFormats>
                            <timestampedReports>false</timestampedReports>
                            <jvmArgs>
                                <jvmArg>-Xmx1g</jvmArg>
                            </jvmArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--  Maven Central publishing: inert in normal builds/CI; activate
                     explicitly with `mvn -P central-release deploy` once the Central
                     Portal account, com.quantfinlib namespace and GPG key exist —
                     the exact steps live in docs/PUBLISHING.md.  -->
        <profile>
            <id>central-release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>