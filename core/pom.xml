<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- Own coordinates first: JitPack's artifact scan reads the first groupId/artifactId/version in the file. -->
    <groupId>com.quantfinlib</groupId>
    <artifactId>quant-finance-library</artifactId>
    <version>3.1.0</version>
    <parent>
        <groupId>com.quantfinlib</groupId>
        <artifactId>quant-finance-library-parent</artifactId>
        <version>3.1.0</version>
    </parent>
    <packaging>jar</packaging>
    <name>Quant-Finance-Library</name>
    <description>Stable tier of Quant-Finance-Library: pricing, rates, credit, market risk, alpha research, backtesting and execution analytics. Pure JDK.</description>
    <properties>
        <qfl.module>com.quantfinlib</qfl.module>
    </properties>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.quantfinlib.cli.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- API compatibility gate (japicmp) against the released 3.0.0 core
             jar (api.baseline.version in the parent POM). Every package of this
             module is stable tier and fails the build on a binary-incompatible
             change; there is no allow-list.
               bash scripts/fetch-api-baseline.sh
               ./mvnw -Papi-compat -DskipTests verify
             Report: core/target/japicmp/api-stable.html. -->
        <profile>
            <id>api-compat</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.siom79.japicmp</groupId>
                        <artifactId>japicmp-maven-plugin</artifactId>
                        <version>${japicmp.version}</version>
                        <configuration>
                            <oldVersion>
                                <file>
                                    <path>${api.baseline.jar}</path>
                                </file>
                            </oldVersion>
                            <newVersion>
                                <file>
                                    <path>${project.build.directory}/${project.build.finalName}.jar</path>
                                </file>
                            </newVersion>
                        </configuration>
                        <executions>
                            <execution>
                                <id>api-stable</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>cmp</goal>
                                </goals>
                                <configuration>
                                    <parameter>
                                        <onlyModified>true</onlyModified>
                                        <accessModifier>protected</accessModifier>
                                        <ignoreMissingClasses>true</ignoreMissingClasses>
                                        <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                                        <breakBuildOnSourceIncompatibleModifications>false</breakBuildOnSourceIncompatibleModifications>
                                        <includes>
                                            <include>com.quantfinlib.*</include>
                                        </includes>
                                        <!-- No allow-list: 3.x makes no breaking changes
                                             (docs/STABILITY.md), so any binary-incompatible
                                             change against 3.0.0 fails the build and is
                                             fixed in code, not excluded here. -->
                                    </parameter>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
