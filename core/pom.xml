<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- Own coordinates first: JitPack's artifact scan reads the first groupId/artifactId/version in the file. -->
    <groupId>com.quantfinlib</groupId>
    <artifactId>quant-finance-library</artifactId>
    <version>4.0.0</version>
    <parent>
        <groupId>com.quantfinlib</groupId>
        <artifactId>quant-finance-library-parent</artifactId>
        <version>4.0.0</version>
    </parent>
    <packaging>jar</packaging>
    <name>Quant-Finance-Library</name>
    <description>Stable tier of Quant-Finance-Library: pricing, rates, credit, market risk, alpha research, backtesting and execution analytics. Pure JDK, java.base only.</description>
    <properties>
        <qfl.module>com.quantfinlib</qfl.module>
    </properties>
    <profiles>
        <!-- API compatibility gate (japicmp) against the released 3.2.0 core
             jar (api.baseline.version in the parent POM). Every package of this
             module is stable tier. 4.0 is a major release, so the comparison
             with 3.2.0 reports MAJOR (execution api-stable); the gate
             (api-stable-gate) excludes exactly the 4.0 break list of
             docs/MIGRATION_4.0.md and fails on any other binary-incompatible
             change.
               bash scripts/fetch-api-baseline.sh
               ./mvnw -Papi-compat -DskipTests verify
             Report: core/target/japicmp/api-stable.html. -->
        <profile>
            <id>api-compat</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.siom79.japicmp</groupId>
                        <artifactId>japicmp-maven-plugin</artifactId>
                        <version>${japicmp.version}</version>
                        <configuration>
                            <oldVersion>
                                <file>
                                    <path>${api.baseline.jar}</path>
                                </file>
                            </oldVersion>
                            <newVersion>
                                <file>
                                    <path>${project.build.directory}/${project.build.finalName}.jar</path>
                                </file>
                            </newVersion>
                        </configuration>
                        <executions>
                            <!-- Report: the full comparison with 3.2.0. For 4.0 it
                                 reports semver MAJOR (the moves and removals of
                                 docs/MIGRATION_4.0.md); it does not fail the build. -->
                            <execution>
                                <id>api-stable</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>cmp</goal>
                                </goals>
                                <configuration>
                                    <parameter>
                                        <onlyModified>true</onlyModified>
                                        <accessModifier>protected</accessModifier>
                                        <ignoreMissingClasses>true</ignoreMissingClasses>
                                        <breakBuildOnBinaryIncompatibleModifications>false</breakBuildOnBinaryIncompatibleModifications>
                                        <breakBuildOnSourceIncompatibleModifications>false</breakBuildOnSourceIncompatibleModifications>
                                        <includes>
                                            <include>com.quantfinlib.*</include>
                                        </includes>
                                    </parameter>
                                </configuration>
                            </execution>
                            <!-- Gate: the same comparison with the explicit 4.0 break
                                 list excluded. Each exclude is one row of
                                 docs/MIGRATION_4.0.md; any other binary-incompatible
                                 change fails the build. -->
                            <execution>
                                <id>api-stable-gate</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>cmp</goal>
                                </goals>
                                <configuration>
                                    <parameter>
                                        <onlyModified>true</onlyModified>
                                        <accessModifier>protected</accessModifier>
                                        <ignoreMissingClasses>true</ignoreMissingClasses>
                                        <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                                        <breakBuildOnSourceIncompatibleModifications>false</breakBuildOnSourceIncompatibleModifications>
                                        <includes>
                                            <include>com.quantfinlib.*</include>
                                        </includes>
                                        <excludes>
                                            <!-- MIGRATION_4.0 row 1: examples jar -->
                                            <exclude>com.quantfinlib.cli.*</exclude>
                                            <exclude>com.quantfinlib.backtest.strategies.*</exclude>
                                            <!-- row 2: lowlatency marketdata.AggregatedBook -->
                                            <exclude>com.quantfinlib.fx.AggregatedBook</exclude>
                                            <!-- row 3: lowlatency -->
                                            <exclude>com.quantfinlib.rfq.*</exclude>
                                            <exclude>com.quantfinlib.marketdata.tick.*</exclude>
                                            <exclude>com.quantfinlib.backtest.tick.*</exclude>
                                            <!-- row 4: io package -->
                                            <exclude>com.quantfinlib.data.CsvBarLoader</exclude>
                                            <exclude>com.quantfinlib.data.HttpBarFetcher</exclude>
                                            <exclude>com.quantfinlib.data.UniverseCsvLoader</exclude>
                                            <exclude>com.quantfinlib.io.*</exclude>
                                            <!-- row 5: io module -->
                                            <exclude>com.quantfinlib.report.*</exclude>
                                            <!-- row 6: research module -->
                                            <exclude>com.quantfinlib.dsl.*</exclude>
                                            <!-- row 8: removed -->
                                            <exclude>com.quantfinlib.rates.SwapPricer</exclude>
                                        </excludes>
                                    </parameter>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
