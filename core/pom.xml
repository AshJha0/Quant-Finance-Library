                                            <!-- MIGRATION_3.0 s.2: package entitlements moved to the low-latency module -->
                                            <exclude>com.quantfinlib.entitlements.*</exclude>
                                            <!-- MIGRATION_3.0 s.2: package feed moved to the low-latency module -->
