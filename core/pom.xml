    <artifactId>quant-finance-library</artifactId>
    <packaging>jar</packaging>
    <name>Quant-Finance-Library</name>
    <description>Stable tier of Quant-Finance-Library: pricing, rates, credit, market risk, alpha research, backtesting and execution analytics. Pure JDK.</description>
    <properties>
        <qfl.module>com.quantfinlib</qfl.module>
    </properties>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.quantfinlib.cli.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- API compatibility gate (japicmp) against the released 2.4.0 jar
             (api.baseline.version in the parent POM). Every package of this
             module is stable tier and fails the build on a binary-incompatible
             change, except the intended 3.0 breaks listed by <exclude> below,
             each with its row in docs/MIGRATION_3.0.md. Packages that moved to
             the low-latency module are not compared here.
               bash scripts/fetch-api-baseline.sh
               ./mvnw -Papi-compat -DskipTests verify
             Report: core/target/japicmp/api-stable.html. -->
        <profile>
            <id>api-compat</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.siom79.japicmp</groupId>
                        <artifactId>japicmp-maven-plugin</artifactId>
                        <version>${japicmp.version}</version>
                        <configuration>
                            <oldVersion>
                                <file>
                                    <path>${api.baseline.jar}</path>
                                </file>
                            </oldVersion>
                            <newVersion>
                                <file>
                                    <path>${project.build.directory}/${project.build.finalName}.jar</path>
                                </file>
                            </newVersion>
                        </configuration>
                        <executions>
                            <execution>
                                <id>api-stable</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>cmp</goal>
                                </goals>
                                <configuration>
                                    <parameter>
                                        <onlyModified>true</onlyModified>
                                        <accessModifier>protected</accessModifier>
                                        <ignoreMissingClasses>true</ignoreMissingClasses>
                                        <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                                        <breakBuildOnSourceIncompatibleModifications>false</breakBuildOnSourceIncompatibleModifications>
                                        <includes>
                                            <include>com.quantfinlib.*</include>
                                        </includes>
